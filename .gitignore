## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET
*.user
*.suo
*.cache
*.userosscache
*.sln.docstates
*.vs/

# NuGet
**/[Pp]ackages/*
*.nupkg
.nuget/
**/packages/*

# Rider
.idea/

# OS files
.DS_Store
Thumbs.db

# Env files — NEVER commit credentials
.env
.env.local
.env.*.local
